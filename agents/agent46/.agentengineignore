# .agentengineignore — files left out of the source archive uploaded by 'agentengine build'.
# Read from the archive root (the repo/workspace root for monorepos).
# Uses standard .gitignore syntax (globs, **, !negation); edit to fit your project.
# .env / .env.* files, *.pem / *.key secrets, and the .git directory are always
# excluded and cannot be re-included, even if you delete this file or add a
# negation for them here.

# Version control
.git

# Python
.venv*
__pycache__
.pytest_cache
.mypy_cache
.ruff_cache
*.pyc

# Node
node_modules

# Build output
dist
build

# Local env files
.env
.env.*

# Agent Engine local state
.agentengine
.agentic

# OS junk
.DS_Store

# Keys & certificates (also always excluded as an un-removable floor)
*.pem
*.key

# Never ship conversation content, model replies or human ground truth to the platform.
logs/
.evolve_cache/
evals/scenarios/docket.json

# Host-side tooling and tests do not run in the deployed agent (HANDOFF section 4).
harness_evolve/
tests/
