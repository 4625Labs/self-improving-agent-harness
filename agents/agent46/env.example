# Copy this file to .env before running the app.
# `agent.yaml` owns app metadata and feature flags; `src/agent_agent46/llm.py`
# owns the provider and model.
# `.env` should only contain local secrets.

# MongoDB connection string for the app and Agent Engine runtime.
# Leave empty for local `agentengine dev`; the CLI provides the local MongoDB URI.
# Set this only when running against your own MongoDB deployment.
MONGODB_URI=

# MongoDB database used by this app's policy and claim collections.
MONGODB_DATABASE=agent_agent46_local

# MongoDB database used by the Agent Engine runtime for checkpoints, memory, and traces.
# Keep this distinct from MONGODB_DATABASE so app data and runtime data stay separate.
MDB_AGENTIC_STORE_DB=mdb_store_agent_agent46_local

# LLM credentials. Set the key read by the builder in src/agent_agent46/llm.py.
# When switching providers, update the client and model in source.

# Credential for the LLM client in the agent source.

# Voyage API key for memory embeddings.
# Required only when `features.memory: true` in agent.yaml.
VOYAGE_API_KEY=
LLM_API_KEY=

# ---------------------------------------------------------------------------------------------
# Host-side tools only (harness_evolve CLI and the live tests). The deployed agent does NOT
# read these. Export them in your shell instead of putting them in .env, because the agent
# reads MONGODB_URI from .env and a host address would break it inside the container.
#
# Docker Mongo is a replica set that advertises an internal hostname, so connecting from the
# host needs directConnection=true or server selection times out. The port is assigned per
# machine: run `agentengine dev status` and read the "mongo" line.
#
#   export EVOLVE_MONGODB_URI="mongodb://localhost:<port>/?directConnection=true"
#   export TEST_MONGODB_URI="mongodb://localhost:<port>/?directConnection=true"
#
# Memory live tests (tests/test_memory_policy.py) skip themselves when these are unreachable:
#   export MEMORY_BASE_URL="http://localhost:<oe-port>"      # the "oe" line of dev status
#   export MEMORY_DB="mdb_memory_<project-id>"               # the memory server's database

